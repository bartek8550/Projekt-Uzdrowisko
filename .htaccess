DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -MultiViews

RewriteEngine On

# Nieprawidłowy host zawsze przechodzi jednym krokiem na HTTPS non-www.
RewriteCond %{HTTP_HOST} !^uzdrowisko-marki\.pl$ [NC]
RewriteRule ^ https://uzdrowisko-marki.pl%{REQUEST_URI} [R=301,L,NE]

# Obsługa bezpośredniego HTTP i poprawne zachowanie za reverse proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://uzdrowisko-marki.pl%{REQUEST_URI} [R=301,L,NE]

# Jedna publiczna postać URL: bez index(.html), rozszerzenia .html i trailing slash.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^index(?:\.html)?/?$ / [R=301,L,NE]

# Dokument błędu nigdy nie jest publiczną stroną 200.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^404(?:\.html)?/?$ - [R=404,L]

RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html(?:[?\s]) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)\.html$ /$1 [R=301,L,NE]

RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)/$ /$1 [R=301,L,NE]

# Rewrite tylko wtedy, gdy konkretny prerenderowany plik istnieje.
RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)$ $1.html [END]

<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=0, must-revalidate"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; script-src-attr 'none'; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self'; frame-src https://www.google.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" "expr=%{REQUEST_URI} == '/sw.js'"
  Header always set CDN-Cache-Control "no-store" "expr=%{REQUEST_URI} == '/sw.js'"
  Header always set Cache-Control "public, max-age=3600, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/(robots\.txt|sitemap\.xml)$#"
  Header always unset Expires "expr=%{REQUEST_URI} == '/sw.js'"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
