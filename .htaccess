DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -MultiViews

RewriteEngine On

# Nieprawidłowy host zawsze przechodzi jednym krokiem na HTTPS non-www.
RewriteCond %{HTTP_HOST} !^uzdrowisko-marki\.pl$ [NC]
RewriteRule ^ https://uzdrowisko-marki.pl%{REQUEST_URI} [R=301,L,NE]

# Obsługa bezpośredniego HTTP i poprawne zachowanie za reverse proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://uzdrowisko-marki.pl%{REQUEST_URI} [R=301,L,NE]

# Jedna publiczna postać URL: bez index(.html), rozszerzenia .html i trailing slash.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^index(?:\.html)?/?$ / [R=301,L,NE]

# Dokument błędu nigdy nie jest publiczną stroną 200.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^404(?:\.html)?/?$ - [R=404,L]

RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html(?:[?\s]) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)\.html$ /$1 [R=301,L,NE]

RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)/$ /$1 [R=301,L,NE]

# Rewrite tylko wtedy, gdy konkretny prerenderowany plik istnieje.
RewriteCond %{REQUEST_URI} !^/404(?:\.html)?/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9]+(?:[/-][a-z0-9]+)*)$ $1.html [END]
